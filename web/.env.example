# Public Supabase client configuration (used by src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional grounded-tutor fallback. Keep the real value only in .env.local.
DEEPSEEK_API_KEY=

# Reserved for a future server-only subjective-marking route. It may read the
# private marking-context RPC; never expose this value through NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=
