# Public Supabase client configuration (used by src/lib/supabase/server.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional grounded-tutor fallback. Keep the real value only in .env.local.
DEEPSEEK_API_KEY=

# Required for marking and recording assessments. The server-only marking RPCs are
# granted to service_role alone, and recording an attempt has to bypass RLS because
# learners deliberately have no insert policy on their own results. Without it,
# /api/attempts and /api/quiz/* return 503. Never expose it via NEXT_PUBLIC_.
# Note: `vercel env pull` returns this as the literal string "[SENSITIVE]" — copy the
# real value from Supabase Dashboard -> Project Settings -> API -> service_role.
SUPABASE_SERVICE_ROLE_KEY=
